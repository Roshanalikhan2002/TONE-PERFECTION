{%- comment -%} Hero (image area left EMPTY) {%- endcomment -%}
<section class="hero">
  <h1 class="hero-title">{{ section.settings.hero_title | default: 'Glass Skin 0.01' }}</h1>
  <div class="hero-series">{{ section.settings.hero_series | default: 'Signature Series' }}</div>
  <div class="hero-image-area">
    {%- if section.settings.hero_image -%}
      {{ section.settings.hero_image | image_url: width: 1200 | image_tag }}
    {%- endif -%}
  </div>
  <div class="hero-brand"><span>TONE</span><span class="seven">7</span></div>

  <!-- Mobile-only hero banner image -->
  <img class="hero-mobile-img" src="{{ 'mobile-hero-banner.jpg' | asset_url }}" alt="Tone Perfection Bundle">
</section>

{%- comment -%} Products (image areas left EMPTY) {%- endcomment -%}
<section class="products">
  <div class="products-grid">
    {%- assign p_serum = all_products['tranexamic-serum'] -%}
    <a class="product-card" href="{% if p_serum != empty %}{{ p_serum.url }}{% else %}#{% endif %}">
      <div class="product-image-area"><img src="{{ 'card-tranexamic-serum.jpg' | asset_url }}" alt="Tranexamic Serum"></div>
      <div class="product-name">TRANEXAMIC SERUM</div>
      <span class="product-btn">{% if p_serum != empty %}BUY - {{ p_serum.price | money }}{% else %}BUY - RS. 2,790{% endif %}</span>
    </a>

    {%- assign p_cream = all_products['tone-correcting-cream'] -%}
    <a class="product-card" href="{% if p_cream != empty %}{{ p_cream.url }}{% else %}#{% endif %}">
      <div class="product-image-area"><img src="{{ 'card-tone-correcting-cream.jpg' | asset_url }}" alt="Tone Correcting Cream"></div>
      <div class="product-name">TONE CORRECTING CREAM</div>
      <span class="product-btn">{% if p_cream != empty %}BUY - {{ p_cream.price | money }}{% else %}BUY - RS. 2,680{% endif %}</span>
    </a>

    {%- assign p_toner = all_products['glycolic-renewal-toner'] -%}
    <a class="product-card" href="{% if p_toner != empty %}{{ p_toner.url }}{% else %}#{% endif %}">
      <div class="product-image-area"><img src="{{ 'card-glycolic-renewal-toner.jpg' | asset_url }}" alt="Glycolic Renewal Toner"></div>
      <div class="product-name">GLYCOLIC RENEWAL TONER</div>
      <span class="product-btn">{% if p_toner != empty %}BUY - {{ p_toner.price | money }}{% else %}BUY - RS. 2,960{% endif %}</span>
    </a>

    {%- assign p_cleanser = all_products['tone-repairing-cleanser'] -%}
    <a class="product-card" href="{% if p_cleanser != empty %}{{ p_cleanser.url }}{% else %}#{% endif %}">
      <div class="product-image-area"><img src="{{ 'card-tone-repairing-cleanser.jpg' | asset_url }}" alt="Tone Repairing Cleanser"></div>
      <div class="product-name">TONE REPAIRING CLEANSER</div>
      <span class="product-btn">{% if p_cleanser != empty %}BUY - {{ p_cleanser.price | money }}{% else %}VIEW BUNDLE{% endif %}</span>
    </a>
  </div>
</section>

{%- comment -%} Bundle (image area left EMPTY) {%- endcomment -%}
<section class="bundle">
  <div class="bundle-inner">
    <div class="bundle-image-area">
      {%- if section.settings.bundle_image -%}
        {{ section.settings.bundle_image | image_url: width: 900 | image_tag }}
      {%- else -%}
        <img src="{{ 'tone-perfection-bundle.jpg' | asset_url }}" alt="Tone Perfection Bundle">
      {%- endif -%}
    </div>
    <div class="bundle-content">
      <div class="bundle-tag">NEW!</div>
      <h2 class="bundle-title">Tone Perfection Bundle</h2>
      <p class="bundle-text">Unlock your skin&rsquo;s natural radiance with the Tone Perfection Bundle. This four-product system is carefully designed to target dullness, dark spots, and uneven tone while maintaining hydration and comfort. Following a lightweight, barrier-friendly Korean skincare approach, it combines gentle cleansing, controlled exfoliation, targeted brightening actives, and daily sun protection for clearer, smoother, and radiant skin.</p>
      <a href="{{ routes.all_products_collection_url }}" class="bundle-btn">Shop Now</a>
    </div>
  </div>
</section>

{%- comment -%} FAQ (image area left EMPTY) {%- endcomment -%}
<section class="faq">
  <div class="faq-inner">
    <div class="faq-list">
      <h2 class="faq-title">Frequently Asked Questions</h2>

      <details class="faq-item">
        <summary>Can I use the toner every night? <span class="plus">+</span></summary>
        <div class="faq-answer">Start 2&ndash;3 times per week and increase as tolerated to avoid irritation from exfoliating acids.</div>
      </details>

      <details class="faq-item">
        <summary>Is the Tranexamic Brightening Serum safe for sensitive skin? <span class="plus">+</span></summary>
        <div class="faq-answer">Yes. It combines gentle brightening actives with soothing ingredients like centella to calm the skin.</div>
      </details>

      <details class="faq-item">
        <summary>Can I layer serum under sunscreen? <span class="plus">+</span></summary>
        <div class="faq-answer">Absolutely. Applying serum first enhances hydration and allows sunscreen to absorb evenly.</div>
      </details>

      <details class="faq-item">
        <summary>Will the Korean Gel Sunscreen leave a white cast? <span class="plus">+</span></summary>
        <div class="faq-answer">No. It blends effortlessly, leaving a lightweight, non-greasy finish suitable for all skin.</div>
      </details>
    </div>

    <div class="faq-image-area">
      {%- if section.settings.faq_image -%}
        {{ section.settings.faq_image | image_url: width: 900 | image_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home page",
  "settings": [
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Glass Skin 0.01" },
    { "type": "text", "id": "hero_series", "label": "Hero series text", "default": "Signature Series" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "bundle_image", "label": "Bundle image" },
    { "type": "image_picker", "id": "faq_image", "label": "FAQ image" }
  ],
  "presets": [
    { "name": "Home page" }
  ]
}
{% endschema %}
