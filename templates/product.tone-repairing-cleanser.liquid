{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product">

  <!-- Left: gallery -->
  <div class="gallery">
    <div class="gallery-main">
      {%- if product.featured_image -%}
        <img id="galleryMain" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
      {%- endif -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="gallery-thumbs">
        <div class="thumb-arrow" data-dir="prev" aria-label="Previous">&#8249;</div>
        {%- for image in product.images limit: 4 -%}
          <button type="button" class="thumb{% if forloop.first %} active{% endif %}" data-full="{{ image | image_url: width: 1000 }}">
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}">
          </button>
        {%- endfor -%}
        <div class="thumb-arrow" data-dir="next" aria-label="Next">&#8250;</div>
      </div>
    {%- endif -%}
  </div>

  <!-- Right: info -->
  <div class="info">
    <h1 class="p-title">{{ product.title }}</h1>
    <div class="p-subtitle">Melt &amp; Cleanse</div>
    <div class="p-desc">{{ product.description | default: 'A transforming Tone Repairing Cleanser designed to dissolve makeup, sunscreen, and daily buildup while maintaining skin balance and revealing a fresh, glass-like glow.' }}</div>

    {%- form 'product', product, id: 'cleanserForm', class: 'bogo-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      <div class="p-offer-label">Buy 1 Get 1</div>
      <div class="p-offer-note">Pick one free gift below. Both items are added to your cart together.</div>

      <div class="price-box">
        <span>Buy 1 Get 1 &mdash; you pay today</span>
        <span class="price">{{ current_variant.price | money }}</span>
      </div>

      <div class="gift-heading">Choose your free gift</div>

      <label class="gift-option">
        <input type="radio" name="gift-variant" value="{{ all_products['tranexamic-serum'].selected_or_first_available_variant.id }}" data-name="Tranexamic Serum" checked>
        <div class="gift-thumb"><img src="{{ 'card-tranexamic-serum.jpg' | asset_url }}" alt="Tranexamic Serum"></div>
        <div class="gift-name">Tranexamic Serum</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="gift-variant" value="{{ all_products['tone-correcting-cream'].selected_or_first_available_variant.id }}" data-name="Tone Correcting Cream">
        <div class="gift-thumb"><img src="{{ 'card-tone-correcting-cream.jpg' | asset_url }}" alt="Tone Correcting Cream"></div>
        <div class="gift-name">Tone Correcting Cream</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="gift-variant" value="{{ all_products['glycolic-renewal-toner'].selected_or_first_available_variant.id }}" data-name="Glycolic Renewal Toner">
        <div class="gift-thumb"><img src="{{ 'card-glycolic-renewal-toner.jpg' | asset_url }}" alt="Glycolic Renewal Toner"></div>
        <div class="gift-name">Glycolic Renewal Toner</div>
      </label>

      <button type="submit" name="add" class="add-cart" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}add to cart &mdash; buy 1 get 1{% else %}sold out{% endif %}
      </button>
    {%- endform -%}
  </div>

</section>

<!-- Discover the formula -->
<section class="formula">
  <div class="formula-image-area">
    <img src="{{ 'cleanser-discover.png' | asset_url }}" alt="Tone Repairing Cleanser formula">
  </div>

  <div class="formula-content">
    <h2 class="formula-title">discover the formula</h2>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#10022;</span>
        <span class="acc-label">BENEFITS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Effortlessly melts away makeup and sunscreen buildup</li>
          <li>Deeply cleanses without leaving skin dry or tight</li>
          <li>Helps balance excess oil while maintaining hydration</li>
          <li>Supports and strengthens the skin's natural barrier</li>
          <li>Smooths texture and clears away daily impurities</li>
          <li>Prepares skin for a clearer, more radiant appearance</li>
        </ul>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#9678;</span>
        <span class="acc-label">APPLICATION</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <p class="acc-text">Apply 1-2 pumps of Tone Repairing Cleanser onto dry skin and gently massage to dissolve makeup and impurities. Add a little water to transform it into a soft foam, then rinse thoroughly before continuing your routine.</p>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span class="acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.6L18.5 9.3 13.7 11 12 15.6 10.3 11 5.5 9.3 10.3 7.6z"/><path d="M18.5 14.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg></span>
        <span class="acc-label">TRICKS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Use on dry skin first to break down makeup more effectively</li>
          <li>Add water gradually to activate the foam transformation</li>
          <li>Massage gently for at least 60 seconds for a deeper cleanse</li>
          <li>Follow with a face wash for a complete double-cleansing ritual</li>
        </ul>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span class="acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20c0-8 6-13 15-13 0 9-5 15-13 15-1.2 0-2-.8-2-2z"/><path d="M9 18c2-4 5-6 8-7"/></svg></span>
        <span class="acc-label">KEY INGREDIENTS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Botanical Oils</li>
          <li>Centella Asiatica</li>
          <li>Glycerin</li>
          <li>Vitamin E</li>
          <li>Mild Cleansing Agents</li>
        </ul>
      </div></div>
    </div>
  </div>
</section>

<!-- What's inside -->
<section class="whats-inside">
  <h2 class="whats-title">what's inside</h2>
  <p class="whats-intro">A versatile oil-to-foam formula that dissolves impurities while keeping skin soft and balanced. Here are 2 key ingredients that make it so effective:</p>

  <div class="whats-grid">
    <div class="whats-card">
      <div class="whats-name">BOTANICAL OILS</div>
      <div class="whats-desc">rich, nourishing oils that break down makeup, sunscreen, and excess sebum without stripping the skin</div>
    </div>
    <div class="whats-card">
      <div class="whats-name">VITAMIN E</div>
      <div class="whats-desc">an antioxidant powerhouse that soothes and protects skin while maintaining hydration</div>
    </div>
  </div>

  <p class="whats-extra">also made with Centella Asiatica, Glycerin, Mild Cleansing Agents</p>
</section>

<!-- Product FAQ -->
<section class="pfaq">
  <div class="pfaq-content">
    <h2 class="pfaq-title">FAQ</h2>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Can I use this cleanser daily?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it is gentle enough for daily use and works well as the first step in your cleansing routine.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Do I still need a second cleanser after this?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, for a complete cleanse, it is recommended to follow with a face wash as part of double cleansing.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Is it suitable for oily or acne-prone skin?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it helps remove excess oil and impurities without clogging pores or causing heaviness.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Will it remove waterproof makeup and sunscreen?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, the oil-based formula is designed to effectively dissolve long-wear makeup and SPF.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Does it leave any greasy residue after rinsing?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">No, it transforms into a foam and rinses clean, leaving skin fresh and balanced.</p>
      </div></div>
    </div>
  </div>

  <div class="pfaq-image-area">
    <img src="{{ 'cleanser-faq.png' | asset_url }}" alt="Tone Repairing Cleanser FAQ">
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.acc-head, .pfaq-head').forEach(function (head) {
      head.addEventListener('click', function () {
        head.parentElement.classList.toggle('open');
      });
    });

    var main = document.getElementById('galleryMain');
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumb'));
    function activate(i) {
      if (!thumbs.length || !main) return;
      i = (i + thumbs.length) % thumbs.length;
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      thumbs[i].classList.add('active');
      main.src = thumbs[i].getAttribute('data-full');
    }
    thumbs.forEach(function (t, i) {
      t.addEventListener('click', function () { activate(i); });
    });
    document.querySelectorAll('.thumb-arrow').forEach(function (arrow) {
      arrow.addEventListener('click', function () {
        var current = thumbs.findIndex(function (t) { return t.classList.contains('active'); });
        if (current < 0) current = 0;
        activate(arrow.getAttribute('data-dir') === 'next' ? current + 1 : current - 1);
      });
    });
  })();
</script>
