{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  /* This photo is more portrait, so plain contain left thick side bezels.
     Fill the width (no side bezels) but keep a thin gradient line top/bottom
     so it matches the other product pages. */
  .product .gallery-main img {
    object-fit: cover;
    width: 100%;
    height: calc(100% - 28px);
    margin: 14px 0;
  }
</style>

<section class="product">

  <!-- Left: gallery -->
  <div class="gallery">
    <div class="gallery-main">
      {%- if product.featured_image -%}
        <img id="galleryMain" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
      {%- endif -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="gallery-thumbs">
        <div class="thumb-arrow" data-dir="prev" aria-label="Previous">&#8249;</div>
        {%- for image in product.images limit: 4 -%}
          <button type="button" class="thumb{% if forloop.first %} active{% endif %}" data-full="{{ image | image_url: width: 1000 }}">
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}">
          </button>
        {%- endfor -%}
        <div class="thumb-arrow" data-dir="next" aria-label="Next">&#8250;</div>
      </div>
    {%- endif -%}
  </div>

  <!-- Right: info -->
  <div class="info">
    <h1 class="p-title">{{ product.title }}</h1>
    <div class="p-subtitle">Glow &amp; Repair</div>
    <div class="p-desc">{{ product.description | default: 'A nourishing brightening cream designed to improve uneven tone, reduce dullness, and support skin repair. It helps fade the look of dark spots, restore radiance, and leave skin smoother and healthier with consistent use.' }}</div>

    {%- form 'product', product, id: 'creamForm', class: 'bogo-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      <div class="p-offer-label">Buy 1 Get 1</div>
      <div class="p-offer-note">Pick one free gift below. Both items are added to your cart together.</div>

      <div class="price-box">
        <span>Buy 1 Get 1 &mdash; you pay today</span>
        <span class="price">{{ current_variant.price | money }}</span>
      </div>

      <div class="gift-heading">Choose your free gift</div>

      <label class="gift-option">
        <input type="radio" name="gift-variant" value="{{ all_products['tranexamic-serum'].selected_or_first_available_variant.id }}" data-name="Tranexamic Serum" checked>
        <div class="gift-thumb"><img src="{{ 'card-tranexamic-serum.jpg' | asset_url }}" alt="Tranexamic Serum"></div>
        <div class="gift-name">Tranexamic Serum</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="gift-variant" value="{{ all_products['glycolic-renewal-toner'].selected_or_first_available_variant.id }}" data-name="Glycolic Renewal Toner">
        <div class="gift-thumb"><img src="{{ 'card-glycolic-renewal-toner.jpg' | asset_url }}" alt="Glycolic Renewal Toner"></div>
        <div class="gift-name">Glycolic Renewal Toner</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="gift-variant" value="{{ all_products['tone-repairing-cleanser'].selected_or_first_available_variant.id }}" data-name="Tone Repairing Cleanser">
        <div class="gift-thumb"><img src="{{ 'card-tone-repairing-cleanser.jpg' | asset_url }}" alt="Tone Repairing Cleanser"></div>
        <div class="gift-name">Tone Repairing Cleanser</div>
      </label>

      <button type="submit" name="add" class="add-cart" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}add to cart &mdash; buy 1 get 1{% else %}sold out{% endif %}
      </button>
    {%- endform -%}
  </div>

</section>

<!-- Discover the formula -->
<section class="formula">
  <div class="formula-image-area">
    <img src="{{ 'cream-discover.png' | asset_url }}" alt="Discover the formula">
  </div>

  <div class="formula-content">
    <h2 class="formula-title">discover the formula</h2>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#10022;</span>
        <span class="acc-label">BENEFITS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Helps visibly brighten dull and uneven skin tone</li>
          <li>Supports reduction of dark spots and pigmentation</li>
          <li>Helps improve post-acne marks and discoloration</li>
          <li>Provides deep hydration and skin barrier support</li>
          <li>Leaves skin soft, smooth and radiant</li>
          <li>Helps restore skin clarity and evenness over time</li>
          <li>Promotes a naturally healthy, luminous glow</li>
        </ul>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#9678;</span>
        <span class="acc-label">APPLICATION</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <p class="acc-text">Use morning and evening after cleansing and serum. Apply a small amount to face and neck. Gently massage until fully absorbed. In the morning, follow with sunscreen.</p>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span class="acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.6L18.5 9.3 13.7 11 12 15.6 10.3 11 5.5 9.3 10.3 7.6z"/><path d="M18.5 14.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg></span>
        <span class="acc-label">TRICKS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Apply on slightly damp skin for better absorption</li>
          <li>Use consistently for visible brightening results</li>
          <li>Pair with a serum to enhance results</li>
          <li>Use sunscreen daily to maintain an even tone</li>
          <li>Massage gently to boost skin absorption</li>
        </ul>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span class="acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20c0-8 6-13 15-13 0 9-5 15-13 15-1.2 0-2-.8-2-2z"/><path d="M9 18c2-4 5-6 8-7"/></svg></span>
        <span class="acc-label">KEY INGREDIENTS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Honey</li>
          <li>Centella Asiatica</li>
          <li>Glutathione</li>
          <li>Alpha Arbutin</li>
          <li>Kojic Acid Dipalmitate</li>
          <li>Niacinamide</li>
          <li>Vitamin C</li>
          <li>Hyaluronic Acid</li>
          <li>Glycerin</li>
          <li>Vitamin E</li>
          <li>Amla Extract</li>
        </ul>
      </div></div>
    </div>
  </div>
</section>

<!-- What's inside -->
<section class="whats-inside">
  <h2 class="whats-title">what's inside</h2>
  <p class="whats-intro">A nourishing cream that brightens, repairs, and hydrates skin for a clearer, more even complexion.</p>

  <div class="whats-grid">
    <div class="whats-card">
      <div class="whats-name">HONEY &amp; GLUTATHIONE</div>
      <div class="whats-desc">help restore radiance and fade dullness</div>
    </div>
    <div class="whats-card">
      <div class="whats-name">ALPHA ARBUTIN &amp; KOJIC ACID DIPALMITATE</div>
      <div class="whats-desc">work to reduce dark spots, post-acne marks, and pigmentation</div>
    </div>
  </div>

  <p class="whats-extra">also made with Centella Asiatica, Niacinamide, Vitamin C, Hyaluronic Acid, Glycerin, Vitamin E, and Amla Extract for hydration, skin barrier support, and smooth texture</p>
</section>

<!-- Product FAQ -->
<section class="pfaq">
  <div class="pfaq-content">
    <h2 class="pfaq-title">FAQ</h2>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Can I use this cream every day?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it is suitable for daily use, both morning and evening.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Is it suitable for dull and uneven skin?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it is designed to target dullness, pigmentation, and uneven tone.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Will it feel heavy on my skin?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">No, it absorbs well while still providing deep hydration and comfort.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Can I use it with other skincare products?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it works well with serums, toners, and sunscreen.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Do I need sunscreen while using this?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, sunscreen is essential during the day to protect and maintain results.</p>
      </div></div>
    </div>
  </div>

  <div class="pfaq-image-area">
    <img src="{{ 'cream-faq.png' | asset_url }}" alt="Frequently asked questions">
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.acc-head, .pfaq-head').forEach(function (head) {
      head.addEventListener('click', function () {
        head.parentElement.classList.toggle('open');
      });
    });

    var main = document.getElementById('galleryMain');
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumb'));
    function activate(i) {
      if (!thumbs.length || !main) return;
      i = (i + thumbs.length) % thumbs.length;
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      thumbs[i].classList.add('active');
      main.src = thumbs[i].getAttribute('data-full');
    }
    thumbs.forEach(function (t, i) {
      t.addEventListener('click', function () { activate(i); });
    });
    document.querySelectorAll('.thumb-arrow').forEach(function (arrow) {
      arrow.addEventListener('click', function () {
        var current = thumbs.findIndex(function (t) { return t.classList.contains('active'); });
        if (current < 0) current = 0;
        activate(arrow.getAttribute('data-dir') === 'next' ? current + 1 : current - 1);
      });
    });
  })();
</script>
