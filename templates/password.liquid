{% layout 'password' %}

<section style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px;background:linear-gradient(180deg,#ffe9a6 0%,#f9bcd6 50%,#d8c4ef 100%);">
  <div class="nav-logo" style="position:static;transform:none;font-size:44px;margin-bottom:18px;">{{ shop.name | default: 'TONE PERFECTION' }}</div>
  <p class="bundle-text" style="max-width:420px;color:#6a4a9a;">Opening soon. Enter the store password to take a peek.</p>

  {%- form 'storefront_password' -%}
    <div class="signup-form" style="background:#fff;max-width:340px;margin-top:10px;">
      <input type="password" name="password" placeholder="Enter store password">
      <button type="submit" aria-label="Enter">&#8594;</button>
    </div>
    {%- if form.errors -%}
      <p class="signup-note" style="color:#d4659a;">{{ form.errors.messages['form'] }}</p>
    {%- endif -%}
  {%- endform -%}
</section>
