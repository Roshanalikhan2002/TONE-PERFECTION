<section style="max-width:1000px;margin:0 auto;padding:50px 36px 80px;">
  <h1 class="faq-title">Search</h1>
  {%- form 'search' -%}
    <div class="signup-form" style="max-width:500px;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products...">
      <button type="submit" aria-label="Search">&#8594;</button>
    </div>
  {%- endform -%}
  {%- if search.performed -%}
    <div class="products-grid" style="margin-top:30px;">
      {%- for item in search.results -%}
        <a href="{{ item.url }}" class="product-card">
          <div class="product-name">{{ item.title }}</div>
        </a>
      {%- else -%}
        <p class="bundle-text">No results found.</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
