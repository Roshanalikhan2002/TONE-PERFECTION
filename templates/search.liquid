<style>
  .search-page { max-width: 1080px; margin: 0 auto; padding: 54px 24px 80px; }
  .search-title {
    font-family: 'Dancing Script', cursive;
    font-size: 50px;
    font-weight: 700;
    color: #6a4a9a;
    text-align: center;
    margin-bottom: 22px;
  }
  .search-bar {
    display: flex;
    align-items: center;
    max-width: 560px;
    margin: 0 auto 12px;
    border: 1px solid #e0cdf0;
    border-radius: 40px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(138, 95, 192, 0.10);
  }
  .search-bar svg { width: 20px; height: 20px; stroke: #b083d6; margin-left: 18px; flex: none; }
  .search-bar input {
    flex: 1;
    border: none;
    outline: none;
    padding: 16px 16px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    color: #5b4a73;
    background: transparent;
  }
  .search-bar button {
    border: none;
    background: #e07ba8;
    color: #fff;
    padding: 0 24px;
    align-self: stretch;
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .search-bar button:hover { background: #d4659a; }
  .search-hint { text-align: center; color: #a99bbf; font-family: 'Cormorant Garamond', serif; font-size: 15px; margin-bottom: 30px; }

  .search-count { font-family: 'Cormorant Garamond', serif; color: #8377a0; font-size: 16px; margin: 26px 0 18px; text-align: center; }

  .search-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .search-card {
    display: block;
    text-decoration: none;
    border: 1px solid #f0e2f3;
    border-radius: 14px;
    overflow: hidden;
    background: #fffdfa;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .search-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(138, 95, 192, 0.14); }
  .search-card-img {
    width: 100%;
    height: 220px;
    background: linear-gradient(180deg, #fff6e3, #fbe3ee 55%, #efe6fb);
    overflow: hidden;
  }
  .search-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .search-card-body { padding: 14px 16px 18px; }
  .search-card-name { font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 700; color: #5b4a73; }
  .search-card-price { font-family: 'Cormorant Garamond', serif; color: #6a4a9a; font-size: 16px; margin-top: 4px; }

  .search-empty { text-align: center; font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #6f6088; margin-top: 36px; }

  @media (max-width: 900px) { .search-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .search-title { font-size: 38px; } .search-card-img { height: 180px; } }
</style>

<section class="search-page">
  <h1 class="search-title">Search</h1>

  {%- form 'search' -%}
    <div class="search-bar">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
      </svg>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for serums, creams, toners..." autofocus>
      <button type="submit">Search</button>
    </div>
  {%- endform -%}
  <p class="search-hint">Type a product name or keyword and press Search.</p>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <p class="search-count">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;</p>
      <div class="search-grid">
        {%- for item in search.results -%}
          <a href="{{ item.url }}" class="search-card">
            <div class="search-card-img">
              {%- if item.featured_image -%}
                <img src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}">
              {%- elsif item.image -%}
                <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.title | escape }}">
              {%- endif -%}
            </div>
            <div class="search-card-body">
              <div class="search-card-name">{{ item.title }}</div>
              {%- if item.object_type == 'product' -%}
                <div class="search-card-price">{{ item.price | money }}</div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="search-empty">No results found for &ldquo;{{ search.terms | escape }}&rdquo;. Try another keyword.</p>
    {%- endif -%}
  {%- endif -%}
</section>
