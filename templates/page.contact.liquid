<style>
  .contact-page {
    background:
      radial-gradient(900px 500px at 0% 0%, #fff3c4 0%, transparent 55%),
      radial-gradient(900px 600px at 100% 0%, #fcd0e6 0%, transparent 55%),
      radial-gradient(1000px 700px at 50% 100%, #e3d5fb 0%, transparent 60%),
      #fffaf2;
    padding: 60px 24px 90px;
  }
  .contact-wrap { max-width: 1080px; margin: 0 auto; }

  .contact-head { text-align: center; margin-bottom: 46px; }
  .contact-title {
    font-family: 'Dancing Script', cursive;
    font-size: 64px;
    font-weight: 700;
    color: #6a4a9a;
    margin-bottom: 14px;
    line-height: 1;
  }
  .contact-intro {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    line-height: 1.7;
    color: #6f6088;
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px;
  }
  .contact-card {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(4px);
    border: 1px solid #f0e2f3;
    border-radius: 18px;
    padding: 30px 32px;
    box-shadow: 0 14px 34px rgba(138, 95, 192, 0.10);
  }
  .contact-card.full { grid-column: 1 / -1; }

  .card-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px; height: 54px;
    border-radius: 14px;
    margin-bottom: 16px;
    color: #fff;
  }
  .card-badge svg { width: 26px; height: 26px; }
  .badge-pink { background: linear-gradient(135deg, #f6a5cb, #e07ba8); }
  .badge-purple { background: linear-gradient(135deg, #c4a3ec, #8a5fc0); }
  .badge-yellow { background: linear-gradient(135deg, #ffd86b, #f3b53d); }
  .badge-mint { background: linear-gradient(135deg, #b9e6cf, #7bc6a0); }

  .card-title {
    font-family: 'Dancing Script', cursive;
    font-size: 30px;
    font-weight: 700;
    color: #6a4a9a;
    margin-bottom: 10px;
  }
  .card-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    line-height: 1.7;
    color: #6f6088;
  }
  .card-contact {
    display: inline-block;
    font-size: 19px;
    font-weight: 700;
    color: #e07ba8;
    margin-bottom: 10px;
    text-decoration: none;
    word-break: break-word;
  }
  .card-contact.wa { color: #7bc6a0; }
  .card-list { margin: 8px 0 0; padding-left: 20px; }
  .card-list li {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    color: #6f6088;
    margin-bottom: 6px;
  }
  .card-strong { font-weight: 700; color: #6a4a9a; }

  .hours-line { font-size: 18px; color: #6a4a9a; font-weight: 600; margin-bottom: 4px; }

  .commit-card {
    text-align: center;
    background: linear-gradient(135deg, #fff3c4 0%, #fcd0e6 50%, #e3d5fb 100%);
    border: none;
  }
  .commit-card .card-text { color: #5b4a73; max-width: 760px; margin: 0 auto; }
  .commit-thanks {
    font-family: 'Dancing Script', cursive;
    font-size: 26px;
    color: #6a4a9a;
    margin-top: 16px;
  }

  /* Message form */
  .form-card .card-text { margin-bottom: 22px; }
  .contact-form { margin-top: 4px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .form-field { margin-bottom: 18px; display: flex; flex-direction: column; }
  .form-field label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-weight: 700;
    color: #6a4a9a;
    margin-bottom: 7px;
  }
  .form-field input,
  .form-field textarea {
    width: 100%;
    border: 1px solid #ecdce6;
    border-radius: 12px;
    padding: 13px 16px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    color: #5b4a73;
    background: #fff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }
  .form-field textarea { resize: vertical; }
  .form-field input:focus,
  .form-field textarea:focus {
    border-color: #e07ba8;
    box-shadow: 0 0 0 3px rgba(224, 123, 168, 0.15);
  }
  .form-btn {
    margin-top: 6px;
    padding: 15px 44px;
    border: none;
    border-radius: 40px;
    background: linear-gradient(135deg, #f6a5cb, #e07ba8);
    color: #fff;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 12px 26px rgba(224, 123, 168, 0.30);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .form-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 32px rgba(224, 123, 168, 0.42); }
  .form-success {
    background: #e7f6ee;
    border: 1px solid #b9e6cf;
    color: #3f7d5c;
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 18px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
  }
  .form-error {
    background: #fdeaf1;
    border: 1px solid #f6c3da;
    color: #b14a78;
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 18px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
  }

  @media (max-width: 768px) {
    .contact-page { padding: 40px 16px 60px; }
    .contact-title { font-size: 46px; }
    .contact-intro { font-size: 17px; }
    .contact-grid { grid-template-columns: 1fr; gap: 18px; }
    .contact-card { padding: 24px 22px; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<section class="contact-page">
  <div class="contact-wrap">

    <div class="contact-head">
      <h1 class="contact-title">Contact Us</h1>
      <p class="contact-intro">We&rsquo;re here to assist you with product inquiries, order support, and general questions. Our team aims to provide a smooth, responsive, and customer-friendly experience at every step.</p>
    </div>

    <div class="contact-grid">

      <!-- Email -->
      <div class="contact-card">
        <span class="card-badge badge-pink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </span>
        <h2 class="card-title">Email Support</h2>
        <a class="card-contact" href="mailto:iibdaeielaris7@gmail.com">iibdaeielaris7@gmail.com</a>
        <p class="card-text">For:</p>
        <ul class="card-list">
          <li>Order-related inquiries</li>
          <li>Product information</li>
          <li>Return &amp; refund support</li>
          <li>General customer assistance</li>
        </ul>
      </div>

      <!-- WhatsApp -->
      <div class="contact-card">
        <span class="card-badge badge-mint">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 21l2-5.5A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.5 9.5c0 3.5 2.5 6 6 6 .7 0 1.2-.6 1-1.3l-.4-1.2-1.8.6-1.5-1.5.6-1.8-1.2-.4c-.7-.2-1.3.3-1.3 1z"/></svg>
        </span>
        <h2 class="card-title">WhatsApp Support</h2>
        <a class="card-contact wa" href="https://wa.me/923291934583">+92 329 1934583</a>
        <p class="card-text">For quick support and order updates during business hours.</p>
      </div>

      <!-- Support Hours -->
      <div class="contact-card">
        <span class="card-badge badge-yellow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <h2 class="card-title">Support Hours</h2>
        <div class="hours-line">Monday to Saturday</div>
        <div class="hours-line">10:00 AM &ndash; 6:00 PM (PKT)</div>
        <p class="card-text">Responses outside business hours may take longer during weekends, public holidays, or high-volume periods.</p>
      </div>

      <!-- Business Info -->
      <div class="contact-card">
        <span class="card-badge badge-purple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
        </span>
        <h2 class="card-title">Business Information</h2>
        <p class="card-text"><span class="card-strong">Registered Brand:</span> Tone Perfection Enterprises</p>
        <p class="card-text"><span class="card-strong">Business Address:</span><br>Orchard Block, Paragon City, Lahore, Pakistan</p>
      </div>

      <!-- Message form -->
      <div class="contact-card full form-card">
        <span class="card-badge badge-pink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 5l-9 7L3 5"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
        </span>
        <h2 class="card-title">Send Us a Message</h2>
        <p class="card-text">Fill out the form below and our team will get back to you as soon as possible.</p>

        {%- if form.posted_successfully? -%}
          <div class="form-success">Thank you! Your message has been sent. We&rsquo;ll get back to you soon.</div>
        {%- endif -%}

        {%- form 'contact', class: 'contact-form' -%}
          {%- if form.errors -%}
            <div class="form-error">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="form-row">
            <div class="form-field">
              <label for="cf-name">Name</label>
              <input type="text" id="cf-name" name="contact[name]" value="{{ form.name }}" placeholder="Your name" required>
            </div>
            <div class="form-field">
              <label for="cf-email">Email</label>
              <input type="email" id="cf-email" name="contact[email]" value="{{ form.email }}" placeholder="you@email.com" required>
            </div>
          </div>

          <div class="form-field">
            <label for="cf-phone">Phone (optional)</label>
            <input type="tel" id="cf-phone" name="contact[phone]" value="{{ form.phone }}" placeholder="+92 3XX XXXXXXX">
          </div>

          <div class="form-field">
            <label for="cf-body">Message</label>
            <textarea id="cf-body" name="contact[body]" rows="5" placeholder="How can we help you?" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="form-btn">Send Message</button>
        {%- endform -%}
      </div>

      <!-- Commitment -->
      <div class="contact-card full commit-card">
        <h2 class="card-title">Our Commitment</h2>
        <p class="card-text">At Tone Perfection, we value transparency, trust, and customer care. Every inquiry matters to us, and we strive to provide timely support and a reliable shopping experience for every customer.</p>
        <div class="commit-thanks">Thank you for choosing Tone Perfection.</div>
      </div>

    </div>
  </div>
</section>
