<section class="products">
  <h1 class="faq-title" style="text-align:center;margin:10px 0 30px;">Collections</h1>
  <div class="products-grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="product-card">
        <div class="product-image-area">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 600 | image_tag }}
          {%- endif -%}
        </div>
        <div class="product-name">{{ collection.title }}</div>
      </a>
    {%- endfor -%}
  </div>
</section>
