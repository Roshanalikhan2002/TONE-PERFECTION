{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product">

  <!-- Left: gallery -->
  <div class="gallery">
    <div class="gallery-main">
      {%- if product.featured_image -%}
        <img id="galleryMain" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
      {%- endif -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="gallery-thumbs">
        <div class="thumb-arrow" data-dir="prev" aria-label="Previous">&#8249;</div>
        {%- for image in product.images limit: 4 -%}
          <button type="button" class="thumb{% if forloop.first %} active{% endif %}" data-full="{{ image | image_url: width: 1000 }}">
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}">
          </button>
        {%- endfor -%}
        <div class="thumb-arrow" data-dir="next" aria-label="Next">&#8250;</div>
      </div>
    {%- endif -%}
  </div>

  <!-- Right: info -->
  <div class="info">
    <h1 class="p-title">{{ product.title }}</h1>
    <div class="p-subtitle">{{ product.vendor | default: 'TONE PERFECTION' }} &mdash; radiant skincare</div>
    <div class="p-desc">{{ product.description | default: 'A lightweight brightening serum designed to fade dark spots and even out skin tone without irritation.' }}</div>

    {%- form 'product', product, id: 'tranexamicForm' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      <div class="p-offer-label">Buy 1 Get 1</div>
      <div class="p-offer-note">Pick one free gift below. Both items are added to your cart together.</div>

      <div class="price-box">
        <span>Buy 1 Get 1 &mdash; you pay today</span>
        <span class="price">{{ current_variant.price | money }}</span>
      </div>

      <div class="gift-heading">Choose your free gift</div>

      <label class="gift-option">
        <input type="radio" name="properties[Free gift]" value="Tone Correcting Cream" checked>
        <div class="gift-thumb"><img src="{{ 'card-tone-correcting-cream.jpg' | asset_url }}" alt="Tone Correcting Cream"></div>
        <div class="gift-name">Tone Correcting Cream</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="properties[Free gift]" value="Glycolic Renewal Toner">
        <div class="gift-thumb"><img src="{{ 'card-glycolic-renewal-toner.jpg' | asset_url }}" alt="Glycolic Renewal Toner"></div>
        <div class="gift-name">Glycolic Renewal Toner</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="properties[Free gift]" value="Tone Repairing Cleanser">
        <div class="gift-thumb"><img src="{{ 'card-tone-repairing-cleanser.jpg' | asset_url }}" alt="Tone Repairing Cleanser"></div>
        <div class="gift-name">Tone Repairing Cleanser</div>
      </label>

      <button type="submit" name="add" class="add-cart" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}add to cart &mdash; buy 1 get 1{% else %}sold out{% endif %}
      </button>
    {%- endform -%}
  </div>

</section>

<!-- Discover the formula -->
<section class="formula">
  <div class="formula-image-area">
    <img src="{{ 'tranexamic-discover.png' | asset_url }}" alt="Discover the formula">
  </div>

  <div class="formula-content">
    <h2 class="formula-title">discover the formula</h2>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#10022;</span>
        <span class="acc-label">benefits</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <p class="acc-text">{{ product.metafields.custom.benefits | default: 'Brightens dull skin, fades dark spots, and evens out skin tone for a healthy, radiant glow with continued use.' }}</p>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#9678;</span>
        <span class="acc-label">application</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <p class="acc-text">{{ product.metafields.custom.application | default: 'Apply 2–3 drops to clean skin morning and night, then follow with moisturizer and SPF during the day.' }}</p>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#127807;</span>
        <span class="acc-label">key ingredients</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <p class="acc-text">{{ product.metafields.custom.ingredients | default: 'Tranexamic acid, niacinamide, and centella asiatica work together to brighten and soothe the skin barrier.' }}</p>
      </div></div>
    </div>
  </div>
</section>

<!-- Product FAQ -->
<section class="pfaq">
  <div class="pfaq-content">
    <h2 class="pfaq-title">FAQ</h2>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>can i use this serum daily?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it is gentle enough for daily use&mdash;apply morning and night for best results.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>do i need to wash my face after applying it?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">No. Leave it on and follow with moisturizer and sunscreen as usual.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>will it make my skin greasy?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">No. The lightweight formula absorbs quickly and leaves a non-greasy finish.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>how often should i use it?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Twice daily is ideal, but even once-daily use will show visible improvement over time.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>is it suitable for all skin types?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Absolutely. It is formulated to work beautifully across all skin types, including sensitive skin.</p>
      </div></div>
    </div>
  </div>

  <div class="pfaq-image-area">
    <img src="{{ 'tranexamic-faq.jpg' | asset_url }}" alt="Frequently asked questions">
  </div>
</section>

<script>
  (function () {
    // Accordions (smooth open)
    document.querySelectorAll('.acc-head, .pfaq-head').forEach(function (head) {
      head.addEventListener('click', function () {
        head.parentElement.classList.toggle('open');
      });
    });

    // Gallery thumbnails
    var main = document.getElementById('galleryMain');
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumb'));
    function activate(i) {
      if (!thumbs.length || !main) return;
      i = (i + thumbs.length) % thumbs.length;
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      thumbs[i].classList.add('active');
      main.src = thumbs[i].getAttribute('data-full');
    }
    thumbs.forEach(function (t, i) {
      t.addEventListener('click', function () { activate(i); });
    });
    document.querySelectorAll('.thumb-arrow').forEach(function (arrow) {
      arrow.addEventListener('click', function () {
        var current = thumbs.findIndex(function (t) { return t.classList.contains('active'); });
        if (current < 0) current = 0;
        activate(arrow.getAttribute('data-dir') === 'next' ? current + 1 : current - 1);
      });
    });
  })();
</script>
