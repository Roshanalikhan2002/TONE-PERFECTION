{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product">

  <!-- Left: gallery -->
  <div class="gallery">
    <div class="gallery-main">
      {%- if product.featured_image -%}
        <img id="galleryMain" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
      {%- endif -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="gallery-thumbs">
        <div class="thumb-arrow" data-dir="prev" aria-label="Previous">&#8249;</div>
        {%- for image in product.images limit: 4 -%}
          <button type="button" class="thumb{% if forloop.first %} active{% endif %}" data-full="{{ image | image_url: width: 1000 }}">
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}">
          </button>
        {%- endfor -%}
        <div class="thumb-arrow" data-dir="next" aria-label="Next">&#8250;</div>
      </div>
    {%- endif -%}
  </div>

  <!-- Right: info -->
  <div class="info">
    <h1 class="p-title">{{ product.title }}</h1>
    <div class="p-subtitle">Renew &amp; Refine</div>
    <div class="p-desc">{{ product.description | default: 'A resurfacing toner designed to promote smoother, clearer skin by gently exfoliating and renewing the surface. It helps refine texture, unclog pores, and boost radiance while keeping the skin balanced and comfortable with continued use.' }}</div>

    {%- form 'product', product, id: 'tonerForm' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      <div class="p-offer-label">Buy 1 Get 1</div>
      <div class="p-offer-note">Pick one free gift below. Both items are added to your cart together.</div>

      <div class="price-box">
        <span>Buy 1 Get 1 &mdash; you pay today</span>
        <span class="price">{{ current_variant.price | money }}</span>
      </div>

      <div class="gift-heading">Choose your free gift</div>

      <label class="gift-option">
        <input type="radio" name="properties[Free gift]" value="Tranexamic Serum" checked>
        <div class="gift-thumb"><img src="{{ 'card-tranexamic-serum.jpg' | asset_url }}" alt="Tranexamic Serum"></div>
        <div class="gift-name">Tranexamic Serum</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="properties[Free gift]" value="Tone Correcting Cream">
        <div class="gift-thumb"><img src="{{ 'card-tone-correcting-cream.jpg' | asset_url }}" alt="Tone Correcting Cream"></div>
        <div class="gift-name">Tone Correcting Cream</div>
      </label>

      <label class="gift-option">
        <input type="radio" name="properties[Free gift]" value="Tone Repairing Cleanser">
        <div class="gift-thumb"><img src="{{ 'card-tone-repairing-cleanser.jpg' | asset_url }}" alt="Tone Repairing Cleanser"></div>
        <div class="gift-name">Tone Repairing Cleanser</div>
      </label>

      <button type="submit" name="add" class="add-cart" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}add to cart &mdash; buy 1 get 1{% else %}sold out{% endif %}
      </button>
    {%- endform -%}
  </div>

</section>

<!-- Discover the formula -->
<section class="formula">
  <div class="formula-image-area">
    {%- comment -%} image placeholder — add later {%- endcomment -%}
  </div>

  <div class="formula-content">
    <h2 class="formula-title">discover the formula</h2>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#10022;</span>
        <span class="acc-label">BENEFITS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Promotes gentle exfoliation to remove dead skin buildup</li>
          <li>Helps improve skin texture and overall smoothness</li>
          <li>Supports clearer pores and reduces congestion</li>
          <li>Enhances natural radiance and glow</li>
          <li>Balances hydration while refining the skin</li>
          <li>Helps improve uneven tone and dullness</li>
          <li>Leaves skin feeling fresh, renewed, and refined</li>
        </ul>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span>&#9678;</span>
        <span class="acc-label">APPLICATION</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <p class="acc-text">After cleansing, apply the toner using a cotton pad or fingertips. Gently sweep or press onto face and neck, avoiding the eye area. Allow it to absorb fully before applying serum and moisturizer. Use sunscreen during the day.</p>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span class="acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.6L18.5 9.3 13.7 11 12 15.6 10.3 11 5.5 9.3 10.3 7.6z"/><path d="M18.5 14.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg></span>
        <span class="acc-label">TRICKS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Start with 2–3 times a week and increase gradually</li>
          <li>Apply at night for enhanced skin renewal</li>
          <li>Always follow with hydration to maintain balance</li>
          <li>Use sunscreen daily to protect renewed skin</li>
        </ul>
      </div></div>
    </div>

    <div class="acc-item">
      <div class="acc-head">
        <span class="acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20c0-8 6-13 15-13 0 9-5 15-13 15-1.2 0-2-.8-2-2z"/><path d="M9 18c2-4 5-6 8-7"/></svg></span>
        <span class="acc-label">KEY INGREDIENTS</span>
        <span class="acc-arrow">&#8250;</span>
      </div>
      <div class="acc-body"><div class="acc-body-inner">
        <ul class="acc-text acc-list">
          <li>Glycolic Acid (7%)</li>
          <li>Salicylic Acid</li>
          <li>Niacinamide (5%)</li>
          <li>Witch Hazel (5%)</li>
          <li>Hyaluronic Acid</li>
          <li>Panthenol</li>
          <li>Aloe Vera Extract</li>
          <li>Vitamin E</li>
          <li>Glycerin</li>
          <li>Rose Water</li>
        </ul>
      </div></div>
    </div>
  </div>
</section>

<!-- What's inside -->
<section class="whats-inside">
  <h2 class="whats-title">what's inside</h2>
  <p class="whats-intro">A resurfacing toner designed to reveal smoother, clearer, and more radiant skin by gently exfoliating and refining texture while maintaining hydration and comfort.</p>

  <div class="whats-grid">
    <div class="whats-card">
      <div class="whats-name">GLYCOLIC ACID</div>
      <div class="whats-desc">promotes gentle exfoliation to remove dead skin buildup</div>
    </div>
    <div class="whats-card">
      <div class="whats-name">NIACINAMIDE</div>
      <div class="whats-desc">helps even skin tone and supports clearer pores</div>
    </div>
  </div>

  <p class="whats-extra">also made with salicylic acid, witch hazel, hyaluronic acid, aloe vera extract, panthenol, vitamin E, glycerin, and rose water for hydration, calmness, and glow</p>
</section>

<!-- Product FAQ -->
<section class="pfaq">
  <div class="pfaq-content">
    <h2 class="pfaq-title">FAQ</h2>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Can I use this toner every day?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Start with 2-3 times a week and increase as your skin builds tolerance.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Is it suitable for sensitive skin?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">It can be used on sensitive skin with caution, but patch testing is recommended before use.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Will it help with acne and clogged pores?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, it helps clear pores and reduce buildup, supporting clearer skin over time.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Can I use it with other active ingredients?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Avoid using it with strong exfoliants on the same day to prevent irritation.</p>
      </div></div>
    </div>

    <div class="pfaq-item">
      <div class="pfaq-head"><span>Do I need to use sunscreen with this?</span><span class="pfaq-plus">+</span></div>
      <div class="pfaq-body"><div class="pfaq-body-inner">
        <p class="pfaq-text">Yes, sunscreen is essential during the day as exfoliation can increase sun sensitivity.</p>
      </div></div>
    </div>
  </div>

  <div class="pfaq-image-area">
    {%- comment -%} image placeholder — add later {%- endcomment -%}
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.acc-head, .pfaq-head').forEach(function (head) {
      head.addEventListener('click', function () {
        head.parentElement.classList.toggle('open');
      });
    });

    var main = document.getElementById('galleryMain');
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumb'));
    function activate(i) {
      if (!thumbs.length || !main) return;
      i = (i + thumbs.length) % thumbs.length;
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      thumbs[i].classList.add('active');
      main.src = thumbs[i].getAttribute('data-full');
    }
    thumbs.forEach(function (t, i) {
      t.addEventListener('click', function () { activate(i); });
    });
    document.querySelectorAll('.thumb-arrow').forEach(function (arrow) {
      arrow.addEventListener('click', function () {
        var current = thumbs.findIndex(function (t) { return t.classList.contains('active'); });
        if (current < 0) current = 0;
        activate(arrow.getAttribute('data-dir') === 'next' ? current + 1 : current - 1);
      });
    });
  })();
</script>
