<style>
  .cart-page { max-width: 1000px; margin: 0 auto; padding: 50px 24px 80px; }
  .cart-title {
    font-family: 'Dancing Script', cursive;
    font-size: 48px;
    font-weight: 700;
    color: #6a4a9a;
    margin-bottom: 8px;
  }
  .cart-sub { font-family: 'Cormorant Garamond', serif; color: #8377a0; font-size: 17px; margin-bottom: 26px; }

  .cart-item {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 18px;
    align-items: center;
    border: 1px solid #f0e2f3;
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 14px;
    background: #fffdfa;
  }
  .cart-item-img {
    width: 90px; height: 90px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(180deg, #fff6e3, #efe6fb);
  }
  .cart-item-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cart-item-name { font-size: 19px; font-weight: 700; color: #5b4a73; font-family: 'Cormorant Garamond', serif; }
  .cart-item-meta { font-size: 14px; color: #9a8bb0; font-family: 'Cormorant Garamond', serif; margin-top: 3px; }
  .cart-gift-badge {
    display: inline-block;
    margin-top: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #b9e6cf, #7bc6a0);
    padding: 4px 10px;
    border-radius: 20px;
  }
  .cart-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e0cdf0;
    border-radius: 30px;
    overflow: hidden;
    margin-top: 8px;
  }
  .cart-qty a {
    width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    color: #6a4a9a; text-decoration: none; font-size: 16px;
  }
  .cart-qty span { min-width: 30px; text-align: center; font-size: 15px; color: #5b4a73; }

  .cart-item-price { text-align: right; }
  .cart-item-price .now { font-size: 17px; font-weight: 700; color: #6a4a9a; }
  .cart-item-price .was { display: block; font-size: 14px; color: #b7a9c8; text-decoration: line-through; }
  .cart-item-price .free { color: #7bc6a0; }
  .cart-remove { display: block; margin-top: 8px; font-size: 12px; color: #c98ab0; text-decoration: none; }

  .cart-summary {
    margin-top: 26px;
    border-top: 2px solid #f0e2f3;
    padding-top: 20px;
  }
  .cart-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font-family: 'Cormorant Garamond', serif; color: #6f6088; font-size: 17px; }
  .cart-row.saving { color: #7bc6a0; font-weight: 700; }
  .cart-row.total { font-size: 22px; color: #6a4a9a; font-weight: 700; margin-top: 8px; }
  .cart-checkout {
    width: 100%;
    margin-top: 18px;
    padding: 18px 0;
    border: none;
    border-radius: 40px;
    background: #e07ba8;
    color: #fff;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: background 0.2s;
  }
  .cart-checkout:hover { background: #d4659a; }
  .cart-note { text-align: center; font-size: 13px; color: #a99bbf; margin-top: 12px; font-family: 'Cormorant Garamond', serif; }
  .cart-empty { font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #6f6088; margin-bottom: 20px; }

  @media (max-width: 600px) {
    .cart-item { grid-template-columns: 70px 1fr; }
    .cart-item-img { width: 70px; height: 70px; }
    .cart-item-price { grid-column: 2 / 3; text-align: left; margin-top: 6px; }
  }
</style>

<section class="cart-page">
  <h1 class="cart-title">Your Cart</h1>

  {%- if cart.item_count > 0 -%}
    <p class="cart-sub">Buy 1 Get 1 &mdash; your free gift is included below.</p>

    {%- form 'cart', cart -%}
      {%- for item in cart.items -%}
        <div class="cart-item">
          <div class="cart-item-img">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
            {%- endif -%}
          </div>

          <div class="cart-item-info">
            <div class="cart-item-name">{{ item.product.title }}</div>
            {%- if item.variant.title and item.variant.title != 'Default Title' -%}
              <div class="cart-item-meta">{{ item.variant.title }}</div>
            {%- endif -%}

            {%- assign is_gift = false -%}
            {%- for prop in item.properties -%}
              {%- if prop.last != blank -%}
                {%- if prop.first == 'Free gift' -%}
                  {%- assign is_gift = true -%}
                {%- elsif prop.first == 'Offer' -%}
                  <div class="cart-item-meta">{{ prop.last }}</div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if is_gift -%}
              <span class="cart-gift-badge">Free gift</span>
            {%- endif -%}

            <div class="cart-qty">
              <a href="{{ item.url_to_remove }}" aria-label="Remove one" title="Remove">&minus;</a>
              <span>{{ item.quantity }}</span>
              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Add one">+</a>
            </div>
          </div>

          <div class="cart-item-price">
            {%- if item.original_line_price > item.final_line_price -%}
              <span class="was">{{ item.original_line_price | money }}</span>
              {%- if item.final_line_price == 0 -%}
                <span class="now free">FREE</span>
              {%- else -%}
                <span class="now">{{ item.final_line_price | money }}</span>
              {%- endif -%}
            {%- else -%}
              <span class="now">{{ item.final_line_price | money }}</span>
            {%- endif -%}
            <a href="{{ item.url_to_remove }}" class="cart-remove">Remove</a>
          </div>
        </div>
      {%- endfor -%}

      <div class="cart-summary">
        {%- assign saved = cart.original_total_price | minus: cart.total_price -%}
        <div class="cart-row">
          <span>Subtotal</span>
          <span>{{ cart.original_total_price | money }}</span>
        </div>
        {%- if saved > 0 -%}
          <div class="cart-row saving">
            <span>Buy 1 Get 1 savings</span>
            <span>&minus; {{ saved | money }}</span>
          </div>
        {%- endif -%}
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-row saving">
            <span>{{ discount.title }}</span>
            <span>&minus; {{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="cart-row total">
          <span>Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <button type="submit" name="checkout" class="cart-checkout">Checkout</button>
        <p class="cart-note">Discounts &amp; shipping are calculated at checkout.</p>
      </div>
    {%- endform -%}

  {%- else -%}
    <p class="cart-empty">Your cart is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="bundle-btn">Continue shopping</a>
  {%- endif -%}
</section>
