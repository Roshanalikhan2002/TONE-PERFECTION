<section style="max-width:1180px;margin:0 auto;padding:40px 36px 80px;display:grid;grid-template-columns:1fr 1fr;gap:50px;">
  <div>
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag }}
    {%- else -%}
      <div style="width:100%;height:460px;background:linear-gradient(180deg,#fff6e3,#fbe3ee 50%,#efe6fb);"></div>
    {%- endif -%}
  </div>
  <div>
    <h1 class="bundle-title">{{ product.title }}</h1>
    <p class="bundle-text">{{ product.description }}</p>
    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <p class="bundle-tag">{{ product.price | money }}</p>
      <button type="submit" class="bundle-btn" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to cart{% else %}Sold out{% endif %}
      </button>
    {%- endform -%}
  </div>
</section>
