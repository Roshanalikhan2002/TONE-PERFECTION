<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#e07ba8">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>

  <!-- Announcement bar (non-stop right-to-left marquee) -->
  <div class="announcement">
    <div class="announcement-track">
      {% for i in (1..16) %}<span>• buy 1 get 1 free •</span>{% endfor %}
    </div>
  </div>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-left">
      <div class="hamburger" aria-label="Menu"><span></span><span></span><span></span></div>
      <a href="{{ routes.all_products_collection_url }}" class="shop-link">Shop</a>
    </div>

    <a href="{{ routes.root_url }}" class="nav-logo">{{ shop.name | default: 'TONE PERFECTION' }}</a>

    <div class="nav-right">
      <a href="{{ routes.search_url }}" aria-label="Search">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </a>
      <a href="{{ routes.account_url }}" class="account" aria-label="Account">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round">
          <path d="M6 7h12l-1.2 12.2a1 1 0 0 1-1 .9H8.2a1 1 0 0 1-1-.9L6 7z"></path>
          <path d="M9 7a3 3 0 0 1 6 0"></path>
        </svg>
      </a>
    </div>
  </nav>

  <main>
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-top">

      <details class="footer-col">
        <summary>Policies <span class="plus">+</span></summary>
        <div class="footer-links">
          <a href="{{ pages.privacy-policy.url | default: '/pages/privacy-policy' }}">Privacy Policy</a>
          <a href="#">Refund Policy</a>
          <a href="#">Terms of Service</a>
          <a href="#">Shipping Policy</a>
        </div>
      </details>

      <details class="footer-col">
        <summary>Company <span class="plus">+</span></summary>
        <div class="footer-links">
          <a href="{{ pages.about-us.url | default: '/pages/about-us' }}">About Us</a>
          <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact Us</a>
        </div>
      </details>

      <details class="footer-col">
        <summary>Sign-up <span class="plus">+</span></summary>
        <div class="footer-links">
          <p class="signup-text">Enter your email below to be the first to know about new product launches, exclusive offers, and more!</p>
          {% form 'customer' %}
            <div class="signup-form">
              <input type="email" name="contact[email]" placeholder="Enter your email" required>
              <button type="submit" aria-label="Subscribe">&#8594;</button>
            </div>
          {% endform %}
          <p class="signup-note">By subscribing you agree to the <a href="#">Terms of Use</a> &amp; <a href="#">Privacy Policy</a></p>
        </div>
      </details>

    </div>

    <div class="footer-bottom">
      <svg class="footer-ig" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="0.6" fill="#8a5fc0" stroke="none"></circle>
      </svg>
      <div class="footer-copy">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | default: 'TONE PERFECTION' }}.</div>
    </div>
  </footer>

  <script>
    (function () {
      var desktopMQ = window.matchMedia('(min-width: 769px)');
      function syncFooter() {
        var isDesktop = desktopMQ.matches;
        document.querySelectorAll('.footer-col').forEach(function (col) {
          col.open = isDesktop;
        });
      }
      syncFooter();
      desktopMQ.addEventListener('change', syncFooter);
    })();
  </script>

</body>
</html>
